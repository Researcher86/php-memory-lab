#!/usr/bin/env php
<?php

declare(strict_types=1);

require dirname(__DIR__) . '/vendor/autoload.php';

use App\Cli\Arguments;
use App\Experiment\ExperimentRunner;
use App\Experiment\Options;
use App\Experiment\Output;
use App\Experiment\Registry;

$registry = new Registry(dirname(__DIR__) . '/experiments');

$fail = static function (string $message) use ($registry): never {
    fwrite(STDERR, $message . "\n\n" . usage($registry));

    exit(1);
};

try {
    // --format and --output belong to this script; everything else is the
    // experiment's, and Options is what decides whether it exists.
    $arguments = Arguments::parse(array_slice($argv, 1));
    $options = Options::fromStrings($arguments->except('format', 'output'));
} catch (InvalidArgumentException $e) {
    $fail($e->getMessage());
}

$name = $arguments->command;

if ($name === null) {
    fwrite(STDOUT, usage($registry));

    exit(1);
}

if (!$registry->has($name)) {
    $fail(sprintf('Unknown experiment: %s', $name));
}

$format = $arguments->string('format', 'text');

if (!in_array($format, ['text', 'json'], true)) {
    $fail(sprintf('Unknown format: %s (text or json)', $format));
}

// Refused, rather than writing an empty file and reporting success. A text run
// streams its prose to stdout as the experiment produces it - partly so that
// one forking children does not look hung - so by the time there is a file to
// write, there is nothing left to put in it. Only the JSON result exists as a
// value this script still holds.
if ($arguments->has('output') && $format !== 'json') {
    $fail('--output needs --format=json; a text run streams its prose as it happens, so there is nothing left to save');
}

// In JSON mode the prose is suppressed rather than captured: an experiment
// that forks children writes from several processes at once, and interleaved
// output inside a JSON string would be neither readable nor valid.
$output = new Output(STDOUT, quiet: $format === 'json');

try {
    $result = (new ExperimentRunner($registry))->run($name, $options, $output);
} catch (InvalidArgumentException $e) {
    $fail($e->getMessage());
}

$rendered = $format === 'json'
    ? json_encode($result->toArray(), JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n"
    : '';  // the prose already went to stdout while the experiment ran

if (!$arguments->has('output')) {
    fwrite(STDOUT, $rendered);

    exit(0);
}

$path = $arguments->string('output', '');

if (file_put_contents($path, $rendered) === false) {
    fwrite(STDERR, sprintf("Unable to write %s\n", $path));

    exit(1);
}

fwrite(STDERR, sprintf("wrote %s\n", $path));

function usage(Registry $registry): string
{
    $usage = "Usage: php bin/experiment <experiment> [options]\n\nExperiments:\n";

    foreach ($registry->all() as $name => $experiment) {
        $usage .= sprintf("  %-26s %s\n", $name, $experiment->description);
    }

    $usage .= "\nCommon options:\n";

    foreach (Options::KNOWN as $option => $description) {
        $usage .= sprintf("  --%-24s %s\n", $option . '=N', $description);
    }

    $usage .= sprintf("  --%-24s %s\n", 'format=text|json', 'prose for a reader, or the measurements as JSON');
    $usage .= sprintf("  --%-24s %s\n", 'output=PATH', 'write the JSON result to a file (needs --format=json)');
    $usage .= "\nAn experiment refuses an option it does not read; its own list is in its file.\n";

    return $usage;
}
