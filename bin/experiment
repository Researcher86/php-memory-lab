#!/usr/bin/env php
<?php

declare(strict_types=1);

require \dirname(__DIR__) . '/vendor/autoload.php';

// The full experiment CLI lands in phase 11; until then each phase adds its
// own commands here so its experiments stay reachable through `make experiment`.
$scripts = [
    'memory:empty' => __DIR__ . '/../experiments/01-memory-basics/empty.php',
    'memory:strings' => __DIR__ . '/../experiments/02-arrays-and-strings/strings.php',
    'memory:packed-arrays' => __DIR__ . '/../experiments/02-arrays-and-strings/packed-arrays.php',
    'memory:associative-arrays' => __DIR__ . '/../experiments/02-arrays-and-strings/associative-arrays.php',
    'memory:sparse-arrays' => __DIR__ . '/../experiments/02-arrays-and-strings/sparse-arrays.php',
    'memory:nested-arrays' => __DIR__ . '/../experiments/02-arrays-and-strings/nested-arrays.php',
    'memory:objects' => __DIR__ . '/../experiments/02-arrays-and-strings/objects.php',
    'memory:gc' => __DIR__ . '/../experiments/03-garbage-collection/gc.php',
    'process:fork' => __DIR__ . '/../experiments/04-fork/basic-fork.php',
    'process:fork-with-data' => __DIR__ . '/../experiments/04-fork/fork-with-data.php',
    'process:multiple-forks' => __DIR__ . '/../experiments/04-fork/fork-many.php',
    'process:lifecycle' => __DIR__ . '/../experiments/04-fork/process-lifecycle.php',
    'cow:readonly' => __DIR__ . '/../experiments/05-copy-on-write/read-only.php',
    'cow:single-write' => __DIR__ . '/../experiments/05-copy-on-write/single-write.php',
    'cow:many-writes' => __DIR__ . '/../experiments/05-copy-on-write/many-writes.php',
    'cow:rewrite' => __DIR__ . '/../experiments/05-copy-on-write/rewrite-array.php',
    'cow:multiple-children' => __DIR__ . '/../experiments/05-copy-on-write/multiple-children.php',
];

$usage = "Usage: php bin/experiment <experiment>\n\n"
    . "Available experiments:\n"
    . "  memory:empty            baseline process memory (Phase 1)\n"
    . "  memory:strings          string cost, COW (Phase 2)\n"
    . "  memory:packed-arrays    vs append vs array_fill (Phase 2)\n"
    . "  memory:associative-arrays  string vs numeric keys (Phase 2)\n"
    . "  memory:sparse-arrays    gaps -> hash table (Phase 2)\n"
    . "  memory:nested-arrays    rows, depth, references (Phase 2)\n"
    . "  memory:objects          object overhead (Phase 2)\n"
    . "  memory:gc               refcounts, cycles (Phase 2)\n"
    . "  process:fork            parent and child measured separately (Phase 3)\n"
    . "  process:fork-with-data  1M-int array inherited read-only (Phase 3)\n"
    . "  process:multiple-forks  1/2/4/8/16 children, RSS and PSS (Phase 3)\n"
    . "  process:lifecycle       exit codes, zombies, signals (Phase 3)\n"
    . "  cow:readonly            child reads inherited 1M-int array (Phase 4)\n"
    . "  cow:single-write        child writes one element (Phase 4)\n"
    . "  cow:many-writes         1/1k/10k/1M-element writes (Phase 4)\n"
    . "  cow:rewrite             in-place vs fresh array rewrite (Phase 4)\n"
    . "  cow:multiple-children   4 children, disjoint regions (Phase 4)\n";

$command = $argv[1] ?? null;

if ($command === null) {
    \fwrite(STDOUT, $usage);

    exit(1);
}

$script = $scripts[$command] ?? null;

if ($script === null) {
    \fwrite(STDERR, "Unknown experiment: {$command}\n\n" . $usage);

    exit(1);
}

if (!\is_file($script)) {
    \fwrite(STDERR, "Missing experiment script: {$script}\n");

    exit(1);
}

require $script;